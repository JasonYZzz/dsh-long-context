  "narrative": {
    "northStar": "继承原生 DSH 操作面板",
    "overview": "这是现有 DSH Web 的局部扩展，不是一个新视觉世界。视觉权威来自宿主主题及 `@deepseek-ai/dsh-client-ui-primitives` 的 Modal、Button、SegmentedTabs；本文件记录已实现的继承关系与局部布局，不替宿主重新定义颜色、字体或控件。\n\n系统以紧凑、清晰的正文和操作信息为主。表单与任务按内容自然堆叠，状态、问题与操作结果保持可读；科学文档的原稿保护与实验能力说明作为操作信息呈现。",
    "keyCharacteristics": [
      "宿主主题变量随用户主题变化。",
      "原生控件承担对话框、按钮和流程导航。",
      "系统正文、次级元数据与等宽结果构成局部信息层级。",
      "表单单列堆叠，任务以细分隔线区分，窄屏换行并独立滚动。"
    ],
    "rules": [
      {
        "name": "The Host Theme Rule",
        "body": "保留语义变量绑定；新增局部内容继续使用宿主角色，不以截图取色覆盖用户主题。",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** 继承原生语义色、圆角、Modal、Button 与 SegmentedTabs。",
      "**Do** 保留字段标签、状态语义、错误反馈和键盘焦点。",
      "**Do** 让长路径、任务目标和结果换行，并维持面板的独立滚动。",
      "**Do** 用次级文字呈现操作元数据，用主要文字保持正文和动作可读。"
    ],
    "donts": [
      "**Don't** 将浅色截图的颜色或宿主变量当前值硬编码成扩展主题。",
      "**Don't** 用独立展示字体、装饰材质或新增阴影替换这个局部面板的原生控件语言。",
      "**Don't** 把局部流程或任务列表结构推广为整个 DSH 的页面布局规则。"
    ]
  }
}
