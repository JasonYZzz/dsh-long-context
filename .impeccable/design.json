      "html": "<div class=\"ds-result\"><pre>{\"preview\": true}</pre></div>",
      "css": ".ds-result{color:var(--dsw-alias-label-primary)}.ds-result pre{white-space:pre-wrap;overflow-wrap:anywhere;background:var(--dsw-alias-bg-module-platform);padding:12px;font:12px/1.7 ui-monospace,monospace;max-height:240px;overflow:auto}.ds-result ::selection{background:var(--dsw-alias-bg-overlay)}.ds-result ::-webkit-scrollbar{width:8px}.ds-result ::-webkit-scrollbar-thumb{background:var(--dsw-alias-border-l2);border-radius:8px}@media(prefers-reduced-motion:no-preference){.ds-result{animation:ds-arrive .16s ease-out}@keyframes ds-arrive{from{opacity:.65}to{opacity:1}}}"
    }
