      "html": "<div class=\"ds-field\"><label for=\"ds-path-preview\">工作区内的文档路径</label><input id=\"ds-path-preview\" placeholder=\"例如 evidence/paper.pdf\"></div>",
      "css": ".ds-field{display:grid;gap:6px;font:14px/1.6 system-ui;color:var(--dsw-alias-label-primary)}.ds-field input,.ds-field textarea{box-sizing:border-box;width:100%;padding:10px 12px;border:1px solid var(--dsw-alias-border-l2);border-radius:8px;background:var(--dsw-alias-bg-module-platform);color:var(--dsw-alias-label-primary);font:inherit;caret-color:var(--dsw-alias-label-primary)}.ds-field input:focus-visible,.ds-field textarea:focus-visible{outline:2px solid var(--dsw-alias-label-primary);outline-offset:2px}"
    },
