      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:4px;border:none;border-radius:var(--dsw-radius-md);cursor:pointer;font-family:inherit;font-size:14px;line-height:22px;color:var(--dsw-alias-label-primary);background:transparent;padding:0 14px;height:36px}.ds-button:hover:not(:disabled){background:var(--dsw-alias-interactive-bg-hover)}.ds-button:active:not(:disabled){background:var(--dsw-alias-interactive-bg-active)}.ds-button:disabled{cursor:not-allowed;opacity:.4}.ds-button-sm{height:28px;font-size:12px;line-height:18px;padding:0 10px;border-radius:var(--dsw-radius-sm)}"
