{
  "name": "dsh-long-context",
  "version": "0.1.0",
  "description": "Persistent, evidence-bound long document editing for DSH rc.2",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.12.0",
    "dsh": "0.2.0-rc.2"
  },
  "exports": {
    ".": {
      "types": "./dist/dsh/agent.d.ts",
      "import": "./dist/dsh/agent.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./host": {
      "types": "./dist/dsh/host.d.ts",
      "import": "./dist/dsh/host.js"
    },
    "./agent": {
      "types": "./dist/dsh/agent.d.ts",
      "import": "./dist/dsh/agent.js"
    },
    "./compaction": {
      "types": "./dist/dsh/compaction.d.ts",
      "import": "./dist/dsh/compaction.js"
    },
    "./bundle": "./bundle/host.patch.yml",
    "./bundle/*": "./bundle/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bundle",
    "docs",
    "README.md",
    "LICENSE",
    "CONTEXT.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": [
        "./bundle/host.patch.yml",
        "./bundle/long-context.preset.patch.yml"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration:rc2": "vitest run tests/integration",
    "test:replay": "vitest run tests/replay",
    "build": "tsc -p tsconfig.build.json",
    "acceptance:preflight": "node scripts/acceptance-preflight.mjs",
    "acceptance:web:rc2": "node scripts/acceptance-web.mjs",
    "acceptance:model:rc2": "node scripts/acceptance-model.mjs",
    "evaluate:fixtures": "node scripts/generate-fixtures.mjs",
    "evaluate:gold": "node scripts/score-evaluation.mjs",
    "evaluate:report": "node scripts/export-report.mjs",
    "acceptance:mechanisms:rc2": "node scripts/acceptance-mechanisms.mjs"
  },
  "dependencies": {
    "zod": "4.1.12"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@types/node": "22.18.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "eslint": "9.39.1",
    "typescript-eslint": "8.46.4",
    "js-yaml": "4.1.1"
  }
}
