{
  "name": "dsh-long-context",
  "version": "0.4.0-beta.1",
  "description": "DSH workspace for model-directed long-context work with bounded execution, evidence and resumable delivery",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.13.0",
    "dsh": "0.2.0-rc.2"
  },
  "exports": {
    ".": {
      "types": "./dist/dsh/web.d.ts",
      "import": "./dist/dsh/web.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./host": {
      "types": "./dist/dsh/host.d.ts",
      "import": "./dist/dsh/host.js"
    },
    "./agent": {
      "types": "./dist/dsh/agent.d.ts",
      "import": "./dist/dsh/agent.js"
    },
    "./compaction": {
      "types": "./dist/dsh/compaction.d.ts",
      "import": "./dist/dsh/compaction.js"
    },
    "./bundle": "./bundle/host.patch.yml",
    "./bundle/*": "./bundle/*",
    "./package.json": "./package.json",
    "./web": {
      "types": "./dist/dsh/web.d.ts",
      "import": "./dist/dsh/web.js"
    },
    "./client": "./client/index.js"
  },
  "files": [
    "dist",
    "bundle",
    "docs",
    "README.md",
    "LICENSE",
    "CONTEXT.md",
    "client",
    "screenshots.json"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": [
        "./bundle/host.patch.yml",
        "./bundle/long-context.preset.patch.yml",
        "./bundle/web.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration:rc2": "vitest run tests/integration",
    "test:replay": "vitest run tests/replay",
    "build": "tsc -p tsconfig.build.json",
    "acceptance:preflight": "node scripts/acceptance-preflight.mjs",
    "acceptance:web:rc2": "node scripts/acceptance-web.mjs",
    "acceptance:model:rc2": "node scripts/acceptance-model.mjs",
    "evaluate:fixtures": "node scripts/generate-fixtures.mjs",
    "evaluate:gold": "node scripts/score-evaluation.mjs",
    "evaluate:report": "node scripts/export-report.mjs",
    "acceptance:mechanisms:rc2": "node scripts/acceptance-mechanisms.mjs",
    "evaluate:model-calibration": "node scripts/evaluate-model-calibration.mjs",
    "acceptance:edit": "node scripts/acceptance-edit.mjs",
    "acceptance:research": "node scripts/acceptance-research.mjs",
    "acceptance:generation": "node scripts/acceptance-generation.mjs",
    "acceptance:generation:controlled": "node scripts/acceptance-generation-controlled.mjs",
    "migrate:state": "node scripts/migrate-state.mjs",
    "acceptance:pdf": "node scripts/acceptance-pdf.mjs",
    "evaluate:performance": "node scripts/evaluate-performance.mjs",
    "evaluate:relevance": "node scripts/evaluate-relevance.mjs",
    "evaluate:optimization-report": "node scripts/export-optimization-evidence.mjs",
    "evaluate:general-performance": "node scripts/evaluate-general-performance.mjs",
    "evaluate:general-model": "node scripts/evaluate-general-model.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299",
    "zod": "4.1.12"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@types/node": "22.18.0",
    "eslint": "9.39.1",
    "js-yaml": "4.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JasonYZzz/dsh-long-context.git"
  },
  "homepage": "https://github.com/JasonYZzz/dsh-long-context#readme",
  "bugs": {
    "url": "https://github.com/JasonYZzz/dsh-long-context/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "long-context",
    "document-editing",
    "research",
    "web"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    }
  }
}
