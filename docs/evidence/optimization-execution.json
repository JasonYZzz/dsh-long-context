          "quoteHash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        },
        {
          "start": 48000,
          "end": 60000,
          "decision": "include",
          "reason": "The text provides a formal error decomposition for retrieval-augmented language models (RALMs), explicitly breaking down the probability of incorrect answers into retriever errors, hallucination errors, extraction errors, and lucky guesses. This directly addresses what limits the factual accuracy improvement from RAG.",
          "quoteId": "q25",
          "quoteHash": "498d87b3db2f81aa421dbb968c9547220c5e6a21d17b0fed9e0e9c7b62faddcc"
